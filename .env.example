# Copy to .env and fill in. Never commit .env.

# Shown in the dashboard and the admin panel.
BRAND_NAME=Byteck

# Pages are served at https://PUBLIC_BASE_DOMAIN/<page-name>.
PUBLIC_BASE_DOMAIN=example.com
DASHBOARD_DOMAIN=app.example.com
ADMIN_DOMAIN=admin.example.com

# Comma separated. These accounts get admin rights.
ADMIN_EMAILS=you@example.com
# Optional, comma separated IPs allowed to open the admin panel. Empty = any IP (sign-in still required).
ADMIN_IP_ALLOWLIST=

# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -hex 24  (password of the bundled Postgres)
DB_PASSWORD=

# Only for running without Docker. Docker builds this from DB_PASSWORD.
DATABASE_URL=postgres://app:app@localhost:5432/app

# local = files on the uploads volume, r2 = Cloudflare R2 bucket.
# For r2, uncomment and fill all five R2 lines. Leave them commented out otherwise.
STORAGE_DRIVER=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Public URL of the bucket, no trailing slash, e.g. https://media.example.com
# R2_PUBLIC_BASE=

# Only when using a Cloudflare Tunnel (docker compose --profile tunnel up -d).
TUNNEL_TOKEN=
